<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="brand_purple">#6C63FF</color>
    <color name="card_bg">#1E1E2E</color>
    <color name="dark_bg">#0F0F1A</color>
    <color name="player_blue">#1E88E5</color>
    <color name="player_green">#43A047</color>
    <color name="player_red">#E53935</color>
    <color name="player_yellow">#FDD835</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Ludo Kid</string>
    <string name="correct_answer">Correct! Pawn eliminated!</string>
    <string name="got_it">Got it!</string>
    <string name="main_menu">Main Menu</string>
    <string name="play_again">Play Again</string>
    <string name="roll_dice">Roll Dice</string>
    <string name="wrong_answer">Wrong! Opponent\'s pawn is safe!</string>
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>
    <style name="Theme.FullScreenDialog" parent="android:style/Theme.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>
    <style name="Theme.LudoKid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorError">#F44336</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">#1E1E2E</item>
        <item name="android:navigationBarColor">#1E1E2E</item>
        <item name="android:textColor">@color/white</item>

    </style>
    <style name="Theme.LudoKid.Splash" parent="Theme.LudoKid">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
    </style>
</resources>