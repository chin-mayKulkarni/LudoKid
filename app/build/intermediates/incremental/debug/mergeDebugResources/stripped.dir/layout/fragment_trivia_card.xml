<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:gravity="bottom"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#1E1E2E"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Drag handle -->
            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:background="#44FFFFFF"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp" />

            <!-- Dice result -->
            <TextView
                android:id="@+id/tvDiceResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎲 You rolled: 3"
                android:textColor="#6C63FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <!-- Emoji -->
            <TextView
                android:id="@+id/tvEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔬"
                android:textSize="56sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- Category -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Science"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#6C63FF"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <!-- Fact text -->
            <TextView
                android:id="@+id/tvFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.5"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Memorize hint -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2040"
                android:layout_marginBottom="20dp">
                <TextView
                    android:id="@+id/tvMemorizeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:text="💡 Memorise this! You'll be asked a question if you can kill an opponent's pawn." />
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress countdown -->
            <ProgressBar
                android:id="@+id/progressCountdown"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progress="0"
                android:progressTint="#6C63FF"
                android:layout_marginBottom="12dp" />

            <!-- Got it button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGotIt"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Got it! ✓"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:backgroundColor="#6C63FF" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
